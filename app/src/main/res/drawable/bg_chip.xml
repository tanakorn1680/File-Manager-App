<?xml version="1.0" encoding="utf-8"?>
<!-- Find-option toggle (Aa / W / .*): outlined, filled with the accent tint while on (View.isActivated) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_light" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_hover" />
            <stroke android:width="1dp" android:color="@color/border_strong" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
