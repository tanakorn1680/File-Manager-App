<?xml version="1.0" encoding="utf-8"?>
<!-- Connect screen: page background with a soft neutral glow fading out from the top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item
        android:height="360dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#008B949E"
                android:startColor="#1A8B949E"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
