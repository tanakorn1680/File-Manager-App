<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity host: one child per web screen (showScreen() toggles visibility) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <include layout="@layout/screen_connect" />
    <include layout="@layout/screen_repos" />
    <include layout="@layout/screen_files" />
    <include layout="@layout/screen_editor" />
    <include layout="@layout/screen_upload" />
    <include layout="@layout/screen_releases" />
    <include layout="@layout/screen_release_new" />
    <include layout="@layout/screen_actions" />
    <include layout="@layout/screen_history" />
    <include layout="@layout/view_toast" />

</FrameLayout>
