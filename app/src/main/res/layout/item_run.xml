<?xml version="1.0" encoding="utf-8"?>
<!-- One workflow run: status icon, commit title, "workflow #n · branch · event", status · time · actor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/imgRunStatus"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_status_success" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textRunTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Update README.md" />

        <TextView
            android:id="@+id/textRunMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="Build APK #12 · main · push" />

        <TextView
            android:id="@+id/textRunInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            tools:text="Success · 2h ago · tanakorn1680" />
    </LinearLayout>
</LinearLayout>
