<?xml version="1.0" encoding="utf-8"?>
<!-- One choice input of the "Run workflow" form: tap to pick from the options -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/wfLabel"
        style="@style/App.FieldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/wfSelect"
        style="@style/App.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:drawableTint="@color/text_muted"
        android:focusable="true"
        android:maxLines="1" />
</LinearLayout>
