<?xml version="1.0" encoding="utf-8"?>
<!-- Web: .loading-overlay / .state-msg — one overlay for loading, error and empty states -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/stateSpinner"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/stateIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no"
        android:tint="@color/text_dim"
        android:visibility="gone" />

    <TextView
        android:id="@+id/stateText"
        style="@style/App.StateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stateRetry"
        style="@style/Widget.App.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Retry"
        android:visibility="gone" />

</LinearLayout>
