<?xml version="1.0" encoding="utf-8"?>
<!-- Web: #screen-editor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenEditor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewDirtyDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dirty_dot"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnEditorMenu"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Editor options"
            android:src="@drawable/ic_more_vert" />

        <TextView
            android:id="@+id/btnStage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_stage_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Stage"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCommit"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minHeight="36dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Commit"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Code area: a fixed, non-scrollable line-number gutter kept in sync with editorText's own
         vertical scroll (see EditorScreen.recomputeLineNumbers / the scroll-change listener), plus
         the editable text itself. Pinch here resizes the text (EditorScreen's ScaleGestureDetector);
         the overflow menu's "Word wrap" toggles editorText.setHorizontallyScrolling(). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/editorLineNumbers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:gravity="top|end"
            android:importantForAccessibility="no"
            android:lineSpacingMultiplier="1.35"
            android:minWidth="34dp"
            android:paddingStart="10dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:typeface="monospace" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border" />

        <EditText
            android:id="@+id/editorText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="top|start"
            android:imeOptions="flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- MT Manager-style find bar: query field + live match count + prev/next/case-toggle/close.
         Hidden until "Find in file" is opened; see EditorScreen.openFindBar(). -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="@color/border" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Find"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:minWidth="48dp"
            android:gravity="end"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            tools:text="3/20" />

        <ImageButton
            android:id="@+id/btnFindCase"
            style="@style/App.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Match case"
            android:src="@drawable/ic_check" />

        <ImageButton
            android:id="@+id/btnFindPrev"
            style="@style/App.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Previous match"
            android:rotation="180"
            android:src="@drawable/ic_chevron_down" />

        <ImageButton
            android:id="@+id/btnFindNext"
            style="@style/App.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Next match"
            android:src="@drawable/ic_chevron_down" />

        <ImageButton
            android:id="@+id/btnFindClose"
            style="@style/App.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Close find"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- MT Manager-style quick-symbol row: one tap inserts the symbol at the caret. Always visible
         while editing (hidden only alongside the rest of the controls before a file has loaded). -->
    <HorizontalScrollView
        android:id="@+id/symbolBarScroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/symbolBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="top"
                android:background="@color/border" />
            <!-- Keys are added at runtime in EditorScreen.buildSymbolBar() -->
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
