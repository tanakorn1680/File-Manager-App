<?xml version="1.0" encoding="utf-8"?>
<!-- Web: #screen-editor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenEditor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewDirtyDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dirty_dot"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnEditorFind"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Find and replace"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnEditorMenu"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Editor options"
            android:src="@drawable/ic_more_vert" />

        <TextView
            android:id="@+id/btnStage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_stage_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Stage"
            android:textColor="@color/warning_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCommit"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minHeight="36dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Commit"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Code area: a fixed, non-scrollable line-number gutter kept in sync with editorText's own
         vertical scroll (see EditorScreen.recomputeLineNumbers / the scroll-change listener), plus
         the editable text itself. Pinch here resizes the text (EditorScreen's ScaleGestureDetector);
         the overflow menu's "Word wrap" toggles editorText.setHorizontallyScrolling(). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/editorLineNumbers"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:gravity="top|end"
            android:importantForAccessibility="no"
            android:lineSpacingMultiplier="1.35"
            android:minWidth="34dp"
            android:paddingStart="10dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:typeface="monospace" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border" />

        <EditText
            android:id="@+id/editorText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="top|start"
            android:imeOptions="flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Quick keys (Tab, cursor arrows, symbols): filled in by EditorScreen.buildQuickKeys().
         Shown while the text (or the find field) has focus; the keys never take focus themselves,
         so the keyboard stays up. -->
    <HorizontalScrollView
        android:id="@+id/quickBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_find_bar"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/quickKeys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <!-- Find / replace -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_find_bar"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/findResults"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Results: 0"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnFindCase"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="Match case"
                android:focusable="false"
                android:gravity="center"
                android:text="Aa"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFindWord"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="Whole word"
                android:focusable="false"
                android:gravity="center"
                android:text="W"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFindRegex"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="Regular expression"
                android:focusable="false"
                android:gravity="center"
                android:text=".*"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Find"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnToggleReplace"
                style="@style/App.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Show replace"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replaceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/replaceInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Replace with"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFindPrev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_find_btn"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="PREV"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFindNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_find_btn"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="NEXT"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnReplaceOne"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_find_btn"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="REPLACE"
                android:textColor="@color/success"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnReplaceAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_find_btn"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="ALL"
                android:textColor="@color/success"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFindClose"
                style="@style/App.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Close find"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
