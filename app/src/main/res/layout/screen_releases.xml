<?xml version="1.0" encoding="utf-8"?>
<!-- Web: #screen-releases -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenReleases"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/textTitle"
            style="@style/App.TopbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Releases" />

        <ImageButton
            android:id="@+id/btnNewRelease"
            style="@style/App.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:contentDescription="New release"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listReleases"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include layout="@layout/layout_state" />
    </FrameLayout>
</LinearLayout>
