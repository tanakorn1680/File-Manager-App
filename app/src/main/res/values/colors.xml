<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same palette as the web app's dark theme (style.css :root), for visual consistency -->
    <color name="bg">#0D1117</color>
    <color name="surface">#161B22</color>
    <color name="surface_hover">#1C2330</color>
    <color name="border">#2D333B</color>
    <color name="text_primary">#E6EDF3</color>
    <color name="text_muted">#8B949E</color>
    <color name="text_dim">#6E7681</color>
    <color name="accent">#58A6FF</color>
    <color name="success">#3FB950</color>
    <color name="success_emphasis">#238636</color>
    <color name="danger">#F85149</color>
    <color name="warning">#D29922</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Web accent-light / danger-light / success-light / warning-light variables
         (CSS #RRGGBBAA becomes Android #AARRGGBB, alpha 0x26) -->
    <color name="accent_light">#261F6FEB</color>
    <color name="danger_light">#26F85149</color>
    <color name="success_light">#263FB950</color>
    <color name="warning_light">#26D29922</color>

    <!-- Hard-coded values that style.css uses outside of :root -->
    <color name="accent_pressed">#1557B0</color>
    <color name="warning_text">#E3B341</color>
    <color name="warning_pressed">#3A2F12</color>
    <color name="badge_private_bg">#26F85149</color>
    <color name="file_icon">#5F6368</color>
    <color name="toast_bg">#1F2630</color>
    <color name="scrim">#80000000</color>
    <color name="transparent">#00000000</color>

    <!-- Filled controls: white text on these meets 4.5:1 (it does not on the light accent blue / red) -->
    <color name="accent_emphasis">#1F6FEB</color>
    <color name="danger_emphasis">#DA3633</color>
    <color name="success_emphasis_pressed">#1B6B2C</color>
    <color name="logo_bg">#1B1F23</color>
    <color name="border_strong">#3D444D</color>
</resources>
