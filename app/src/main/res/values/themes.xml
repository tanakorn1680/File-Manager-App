<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReleaseManager" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/success</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- App wide default so every MaterialButton matches the web
             app's button class without repeating this style on each
             button in every layout file. -->
        <item name="materialButtonStyle">@style/Widget.ReleaseManager.Button</item>
        <item name="materialCardViewStyle">@style/Widget.ReleaseManager.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ReleaseManager.Dialog</item>
    </style>

    <!-- Dialogs use the surface color (not bg) for their background, a
         6dp corner radius matching every other surface in the app, and
         route their action buttons through the same button styles as
         the rest of the app rather than Material's stock dialog button
         look. -->
    <style name="ThemeOverlay.ReleaseManager.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/ReleaseManager.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ReleaseManager.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ReleaseManager.Button.Text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ReleaseManager.Dialog</item>
    </style>

    <style name="ReleaseManager.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ShapeAppearance.ReleaseManager.Dialog" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Mirrors the web app's button class exactly: height 44dp, 6dp
         corner radius, font size 15sp, medium weight, no uppercase
         transform, no elevation or shadow (flat, matching the web's
         borderless flat background look). -->
    <style name="Widget.ReleaseManager.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Outline button variant from the web: transparent background, 1dp
         border using the border color, text in the primary text color
         rather than the accent color. -->
    <style name="Widget.ReleaseManager.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">#1AFFFFFF</item>
    </style>

    <!-- Ghost/text button variant from the web: no background, no
         border, accent colored text. Used for low emphasis actions
         such as a dialog Cancel button. -->
    <style name="Widget.ReleaseManager.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">#1A58A6FF</item>
    </style>

    <!-- Mirrors the web app's card surfaces: 6dp radius (not Material's
         usual larger default), 1dp border stroke, no elevation shadow,
         since the web has none, just a flat background plus border. -->
    <style name="Widget.ReleaseManager.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">6dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
